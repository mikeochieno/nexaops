# NexaOps Environment Configuration

# App
BASE_URL=https://nexaops.fly.dev
APP_API_KEY=nexaops_prod_key_change_me

# Database (TiDB Serverless — MySQL compatible)
DB_HOST=gateway01.xxx.shared.aws.tidbcloud.com
DB_NAME=app_manager
DB_USER=xxx.root
DB_PASS=your-password
DB_PORT=4000
# TiDB requires SSL; CA file path if needed (can leave empty, TiDB uses auto-TLS)
DB_SSL_CA=
DB_SSL_VERIFY=
